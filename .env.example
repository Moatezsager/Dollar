# ─── Server ───
PORT=3000
NODE_ENV=development

# ─── CORS (نطاقات مسموحة، مفصولة بفواصل، بدون مسافات) ───
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.onrender.com

# ─── Supabase ───
# VITE_ prefix = exposed to client (anon key only — safe with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service role: SERVER ONLY — NEVER prefix with VITE_
# Leave empty unless you have a specific server-side admin need
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin Auth ───
# Min 16 chars, mix of letters/numbers/symbols
ADMIN_PASSWORD=

# ─── Secrets ───
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
API_HMAC_SECRET=
CRON_SECRET=

# ─── Gemini ───
GEMINI_API_KEY=

# ─── Web Push (VAPID) ───
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─── Telegram (GramJS) ───
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ─── App URL (for keep-alive pings) ───
APP_URL=
